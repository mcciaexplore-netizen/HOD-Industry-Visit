# Neon Postgres connection string (use the pooled connection string from the Neon dashboard)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Vercel Blob read/write token (Vercel > Storage > Blob > your store > .env.local tab)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"

# At least 32 random characters. Generate one in PowerShell:
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 48 | ForEach-Object { [char]$_ })
SESSION_SECRET="change-me-to-a-long-random-string-of-48-characters"
